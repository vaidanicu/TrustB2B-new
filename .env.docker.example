# Values matching docker-compose.yml — copy the relevant lines into .env
# once `docker compose up -d` is running locally, instead of the sqlite/sync
# defaults .env ships with. See README.md "Trecerea la Postgres + Redis".

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trustbridge
DB_USERNAME=trustbridge
DB_PASSWORD=trustbridge

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=trustbridge
AWS_SECRET_ACCESS_KEY=trustbridge-secret
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=trustbridge-media
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
